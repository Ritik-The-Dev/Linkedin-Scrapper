# LinkedIn Voyager session credentials
# Obtain these from your browser's DevTools after logging in to LinkedIn.
# Copy your actual values into .env (never commit .env)

LINKEDIN_LI_AT=your_li_at_cookie_value_here
LINKEDIN_JSESSIONID=ajax:your_jsessionid_value_here
LINKEDIN_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"
