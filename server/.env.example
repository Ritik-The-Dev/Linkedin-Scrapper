# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/linkedin-leads

# ─── LinkedIn Voyager credentials ────────────────────────────────────────────
# Copy these from your authenticated browser session.
# Never commit real values to version control.
LINKEDIN_LI_AT=your_li_at_cookie_here
LINKEDIN_JSESSIONID=ajax:your_jsessionid_here
LINKEDIN_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"

# ─── Import concurrency ──────────────────────────────────────────────────────
# Max parallel LinkedIn requests during Excel import (default: 5)
BATCH_CONCURRENCY=5

# ─── CORS ────────────────────────────────────────────────────────────────────
# Set to your frontend origin in production, e.g. https://your-app.com
# Leave as * for open access during development
CORS_ORIGIN=*

# ─── Debug flags (development only) ─────────────────────────────────────────
# DEBUG_LINKEDIN=true   — print entity counts to stderr in parser
# DEBUG_SAVE_RAW=true   — write raw-linkedin-response.json after each request
