# ─── Server ──────────────────────────────────────────────────────────────────
# Only used by `npm run dev` / `npm start`. Vercel assigns the port itself.
PORT=3000

# ─── MongoDB ─────────────────────────────────────────────────────────────────
# Serverless deploys need a hosted database (e.g. MongoDB Atlas) — localhost is
# not reachable from a Vercel Function.
MONGODB_URI=mongodb://localhost:27017/linkedin-leads

# ─── LinkedIn Voyager credentials ────────────────────────────────────────────
# Copy these from your authenticated browser session.
# Never commit real values to version control.
# Note: LinkedIn ties a session to the IP that created it, so cookies created on
# your machine are usually rejected (HTTP 999) when replayed from a cloud host.
LINKEDIN_LI_AT=your_li_at_cookie_here
LINKEDIN_JSESSIONID=ajax:your_jsessionid_here
LINKEDIN_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"

# ─── Import concurrency ──────────────────────────────────────────────────────
# Max parallel LinkedIn requests during Excel import (default: 5)
BATCH_CONCURRENCY=5

# ─── Upload limit ────────────────────────────────────────────────────────────
# Largest accepted import file, in bytes. Anything above it gets a 400
# INVALID_EXCEL response. Defaults: 10 MB self-hosted, 4 MB on Vercel — Vercel
# rejects request bodies over ~4.5 MB before the function even runs, so raising
# this above 4194304 there has no effect. Hard ceiling: 50 MB.
# MAX_UPLOAD_BYTES=4194304

# ─── CORS ────────────────────────────────────────────────────────────────────
# Set to your frontend origin in production, e.g. https://your-app.vercel.app
# Leave as * for open access during development
CORS_ORIGIN=*

# ─── Debug flags (development only) ─────────────────────────────────────────
# DEBUG_LINKEDIN=true   — print entity counts to stderr in parser
# DEBUG_SAVE_RAW=true   — write raw-linkedin-response.json after each request
