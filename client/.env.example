# Base URL of the backend API. Must include the /api suffix.
VITE_API_BASE_URL=http://localhost:3000/api

# Run the UI against in-memory fixtures instead of the real backend.
# Useful while the backend is unavailable. Set to "true" to enable.
VITE_USE_MOCK_API=false

# Optional: artificial latency (ms) applied to mock responses so loading
# states are visible during development. Ignored unless mock mode is on.
VITE_MOCK_LATENCY=550
